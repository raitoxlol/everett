{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everett-cloudflare-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      { "name": "OWNERS", "class_name": "OwnerRelay" },
      { "name": "AUTH_STATE", "class_name": "HostedAuth" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OwnerRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["HostedAuth"] }
  ]
}
