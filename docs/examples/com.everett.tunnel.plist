<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.everett.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/everett</string>
    <string>tunnel</string>
    <string>watch</string>
    <string>--profile</string>
    <string>everett-dot</string>
    <string>--env-file</string>
    <string>/Users/YOU/.config/everett/tunnel.env</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/everett-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/everett-tunnel.log</string>
</dict>
</plist>
